# AI is hard-disabled by default so a key alone can never create usage or charges.
# Enabling requests is an explicit two-step action: set enabled=true and choose a positive daily cap.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
RESTOBOT_AI_ENABLED=false
RESTOBOT_AI_MAX_REQUESTS_PER_DAY=0
RESTOBOT_AI_MAX_REQUESTS_PER_MINUTE=2
RESTOBOT_AI_MAX_CONCURRENT_REQUESTS=1

# App
APP_URL=http://localhost:3000
PORT=3000

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server only. Never prefix this value with VITE_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Enable only during the first-owner signup window after securing the owner email.
VITE_RESTOBOT_ALLOW_SIGNUP=false

# Restaurant identity (drives weather, branding, wholesaler cutoffs)
RESTOBOT_RESTAURANT_ID=
RESTOBOT_RESTAURANT_NAME=Your Restaurant Name
RESTOBOT_LOCATION=Troy, Michigan
RESTOBOT_WHOLESALERS=Sysco Wholesale, Gordon Food Service (GFS), US Foods
RESTOBOT_CUISINE=American Diner

# Opt-in draft generation. Requires migration 007 and one app process per restaurant.
# Pick an explicit IANA timezone only after the owner confirms it.
RESTOBOT_SCHEDULER_ENABLED=false
RESTOBOT_SCHEDULE_TIMEZONE=America/Detroit
RESTOBOT_SCHEDULE_AT=04:30
